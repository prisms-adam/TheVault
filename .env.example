DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-local-secret"
HOST="127.0.0.1"
PORT=3000
REDIS_HOST="127.0.0.1"
REDIS_PORT=6389

# Google Workspace SSO (server-only; obtain a Web application OAuth client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:3000/vault/api/auth/google/callback"

# Defaults: local login is enabled with no Google credentials, disabled once
# either Google credential is configured. Set false for school deployment.
# ALLOW_LOCAL_AUTH=false
